# Base ROMs and anything extracted from them are never committed
orig/*.nds
*.nds
extract/
/build/

# Tools downloaded or built by configure
tools/dsd
tools/dsd.rev
tools/src/
tools/objdiff-cli
tools/wibo
tools/sjiswrap.exe
tools/mwccarm

.venv
__pycache__/
build.ninja
.ninja_*
objdiff.json

# 3DS port outputs, saves and logs. The ROM stays in orig/ (ignored above).
*.sav
*.3dsx
*.cia
*.elf
*.bnr
*.smdh
*.lst
n3ds/build/
*.log

# Staged NitroFS copied from the user's extract. Never commit it.
/sd-stage/
pbw2-sd/

# Claude Code: per-session state; the project's skills, agents, hooks and settings.json are committed
.claude/worktrees/
.claude/settings.local.json
.claude/audit-state.json
!.claude/settings.json
